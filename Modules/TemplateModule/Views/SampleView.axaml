<UserControl
    x:Class="Score2Stream.TemplateModule.Views.SampleView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:b="using:Score2Stream.TemplateModule.Behaviors"
    xmlns:co="clr-namespace:Score2Stream.Commons.Converters;assembly=Commons"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:en="clr-namespace:Score2Stream.Commons.Enums;assembly=Commons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="80"
    d:DesignWidth="200"
    mc:Ignorable="d"
    IsSelected="{Binding IsSelected, Mode=TwoWay}">

    <UserControl.Resources>
        <co:EnumToStringConverter x:Key="EnumToStringConverter" />
    </UserControl.Resources>

    <Border
        Name="SampleBorder"
        Margin="2"
        VerticalAlignment="Center"
        BorderBrush="LightGray"
        BorderThickness="4"
        CornerRadius="3"
        Classes.IsSelected="{Binding IsSelected}"
        Classes.IsUnverified="{Binding IsUnverified}"
        IsVisible="{Binding IsVisible}">

        <Border.Styles>
            <Style Selector="Border#SampleBorder.IsUnverified">
                <Setter Property="Background" Value="Bisque" />
            </Style>

            <Style Selector="Border#SampleBorder.IsSelected">
                <Setter Property="Background" Value="LightBlue" />
            </Style>

            <Style Selector="Border#SampleBorder">
                <Setter Property="Background" Value="Gainsboro" />
            </Style>
        </Border.Styles>

        <i:Interaction.Behaviors>
            <ia:EventTriggerBehavior EventName="PointerPressed" SourceObject="SampleBorder">
                <ia:InvokeCommandAction Command="{Binding OnSelectionCommand}" />
            </ia:EventTriggerBehavior>
        </i:Interaction.Behaviors>

        <StackPanel Orientation="Horizontal">

            <Border
                Name="ImageBorder"
                Margin="2"
                VerticalAlignment="Center"
                BorderBrush="LightSlateGray"
                BorderThickness="3">

                <i:Interaction.Behaviors>
                    <ia:DataTriggerBehavior
                        Binding="{Binding Type, Converter={StaticResource EnumToStringConverter}}"
                        ComparisonCondition="Equal"
                        Value="{x:Static en:MatchType.Match}">
                        <ia:ChangePropertyAction
                            PropertyName="BorderBrush"
                            TargetObject="ImageBorder"
                            Value="GreenYellow" />
                    </ia:DataTriggerBehavior>
                    <ia:DataTriggerBehavior
                        Binding="{Binding Type, Converter={StaticResource EnumToStringConverter}}"
                        ComparisonCondition="Equal"
                        Value="{x:Static en:MatchType.Similar}">
                        <ia:ChangePropertyAction
                            PropertyName="BorderBrush"
                            TargetObject="ImageBorder"
                            Value="LightPink" />
                    </ia:DataTriggerBehavior>
                    <ia:DataTriggerBehavior
                        Binding="{Binding Type, Converter={StaticResource EnumToStringConverter}}"
                        ComparisonCondition="Equal"
                        Value="{x:Static en:MatchType.None}">
                        <ia:ChangePropertyAction
                            PropertyName="BorderBrush"
                            TargetObject="ImageBorder"
                            Value="LightSlateGray" />
                    </ia:DataTriggerBehavior>
                </i:Interaction.Behaviors>

                <Image
                    Width="40"
                    Height="60"
                    VerticalAlignment="Center"
                    Source="{Binding Bitmap}"
                    Stretch="Uniform" />
            </Border>

            <Grid Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="4" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">

                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Text="Value" />

                    <Border
                        Name="InputBorder"
                        Background="White"
                        CornerRadius="3">
                        <TextBox
                            Name="ValueTextBox"
                            Width="40"
                            VerticalAlignment="Center"
                            Text="{Binding Value, Mode=TwoWay}">

                            <i:Interaction.Behaviors>
                                <ia:EventTriggerBehavior EventName="GotFocus" SourceObject="ValueTextBox">
                                    <ia:InvokeCommandAction Command="{Binding OnFocusGotCommand}" />
                                </ia:EventTriggerBehavior>
                                <ia:EventTriggerBehavior EventName="LostFocus" SourceObject="ValueTextBox">
                                    <ia:InvokeCommandAction Command="{Binding OnFocusLostCommand}" />
                                </ia:EventTriggerBehavior>

                                <b:FocusOnSelectionBehavior IsSelected="{Binding IsSelected, Mode=TwoWay}" />
                            </i:Interaction.Behaviors>

                            <TextBox.KeyBindings>
                                <KeyBinding Command="{Binding OnRemoveCommand}" Gesture="Shift+Delete" />
                                <KeyBinding Command="{Binding OnSelectionNextCommand}" Gesture="Tab" />
                                <KeyBinding Command="{Binding OnSelectionPreviousCommand}" Gesture="Shift+Tab" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </Border>

                </StackPanel>

                <TextBlock
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Text="{Binding Similarity}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>