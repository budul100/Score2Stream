<UserControl
    x:Class="Score2Stream.TemplateModule.Views.TabsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:co="using:Score2Stream.Commons.Converters"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:v="using:Score2Stream.TemplateModule.Views"
    xmlns:vm="using:Score2Stream.TemplateModule.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <co:CountToBackgroundConverter
            x:Key="CountToBackground"
            EmptyBrush="{StaticResource TemplateBackground}"
            FilledBrush="{StaticResource TabStripBackground}" />
    </UserControl.Resources>

    <TabControl
        ItemsSource="{Binding Tabs}"
        SelectedItem="{Binding Tab, Mode=TwoWay}"
        Padding="0"
        Background="{Binding Tabs.Count, Converter={StaticResource CountToBackground}}">

        <TabControl.Styles>
            <Style Selector="TabStrip">
                <Setter Property="Background" Value="{StaticResource TabStripBackground}" />
            </Style>
            <Style Selector="TabItem">
                <Setter Property="Background" Value="{StaticResource TabItemBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
            </Style>
            <Style Selector="TabItem:selected">
                <Setter Property="Background" Value="{StaticResource TabItemSelectedBackground}" />
            </Style>
            <Style Selector="TabItem:pointerover">
                <Setter Property="Background" Value="{StaticResource TabItemHoverBackground}" />
            </Style>
            <Style Selector="TabControl">
                <Setter Property="Padding" Value="0" />
            </Style>
        </TabControl.Styles>

        <TabControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:TemplateViewModel}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Text="{Binding Name}"
                        FontSize="{StaticResource TabFontSize}"
                        VerticalAlignment="Center" />
                    <Button
                        Content="✕"
                        Command="{Binding CloseCommand}"
                        FontSize="{StaticResource TabFontSize}"
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0" />
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
            <DataTemplate DataType="{x:Type vm:TemplateViewModel}">
                <v:TemplateView />
            </DataTemplate>
        </TabControl.ContentTemplate>

    </TabControl>

</UserControl>
