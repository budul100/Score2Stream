<UserControl
    x:Class="Score2Stream.VideoModule.Views.TabsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:sys="using:System"
    xmlns:v="using:Score2Stream.VideoModule.Views"
    xmlns:vm="using:Score2Stream.VideoModule.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <sys:Double x:Key="FontSize">10</sys:Double>
    </UserControl.Resources>

    <TabControl
        ItemsSource="{Binding Tabs}"
        SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
        BorderBrush="#AAAAAA"
        BorderThickness="1">

        <TabControl.Styles>
            <!-- Tab-Header-Leiste -->
            <Style Selector="TabControl > TabStrip">
                <!--<Setter Property="IsVisible" Value="{Binding ShowTabHeaders}" />-->
                <Setter Property="Background" Value="#E8E8E8" />
            </Style>
            <!-- Einzelner Tab-Header -->
            <Style Selector="TabItem">
                <Setter Property="Background" Value="#DEDEDE" />
                <Setter Property="BorderBrush" Value="#AAAAAA" />
                <Setter Property="Padding" Value="8,4" />
            </Style>
            <!-- Aktiver Tab-Header -->
            <Style Selector="TabItem:selected">
                <Setter Property="Background" Value="#F5F5F5" />
            </Style>
            <!-- Hover -->
            <Style Selector="TabItem:pointerover">
                <Setter Property="Background" Value="#ECECEC" />
            </Style>
            <!-- Content-Bereich -->
            <Style Selector="TabControl > Border">
                <Setter Property="Background" Value="#F5F5F5" />
                <Setter Property="BorderBrush" Value="#AAAAAA" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </TabControl.Styles>

        <TabControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:TabViewModel}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Text="{Binding Name}"
                        FontSize="{StaticResource FontSize}"
                        VerticalAlignment="Center" />
                    <Button
                        Content="✕"
                        Command="{Binding CloseCommand}"
                        FontSize="{StaticResource FontSize}"
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0" />
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
            <DataTemplate DataType="{x:Type vm:TabViewModel}">
                <v:InputView DataContext="{Binding Content}" />
            </DataTemplate>
        </TabControl.ContentTemplate>

    </TabControl>

</UserControl>
