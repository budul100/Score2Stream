<UserControl
    x:Class="Score2Stream.VideoModule.Views.TabsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:v="using:Score2Stream.VideoModule.Views"
    xmlns:vm="using:Score2Stream.VideoModule.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource TabStripBackground}">

    <TabControl
        Margin="6,6,6,0"
        ItemsSource="{Binding Tabs}"
        SelectedItem="{Binding Tab, Mode=TwoWay}"
        BorderBrush="{StaticResource TabBorderBrush}"
        BorderThickness="1">

        <TabControl.Styles>
            <!-- Tab header strip -->
            <Style Selector="TabStrip">
                <Setter Property="Background" Value="{StaticResource TabStripBackground}" />
            </Style>
            <!-- Single tab header -->
            <Style Selector="TabItem">
                <Setter Property="Background" Value="{StaticResource TabItemBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
                <Setter Property="Padding" Value="8,4" />
            </Style>
            <!-- Active tab header -->
            <Style Selector="TabItem:selected">
                <Setter Property="Background" Value="{StaticResource TabItemSelectedBackground}" />
            </Style>
            <!-- Hover -->
            <Style Selector="TabItem:pointerover">
                <Setter Property="Background" Value="{StaticResource TabItemHoverBackground}" />
            </Style>
            <!-- Content area -->
            <Style Selector="TabControl > Border">
                <Setter Property="Background" Value="{StaticResource TabContentBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </TabControl.Styles>

        <TabControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:TabViewModel}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Text="{Binding Name}"
                        FontSize="{StaticResource TabFontSize}"
                        VerticalAlignment="Center" />
                    <Button
                        Content="✕"
                        Command="{Binding CloseCommand}"
                        FontSize="{StaticResource TabFontSize}"
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0" />
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
            <DataTemplate DataType="{x:Type vm:TabViewModel}">
                <v:InputView DataContext="{Binding Content}" />
            </DataTemplate>
        </TabControl.ContentTemplate>

    </TabControl>

</UserControl>
