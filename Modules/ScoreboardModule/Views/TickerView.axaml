<UserControl
    x:Class="Score2Stream.ScoreboardModule.Views.TickerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Score2Stream.Commons.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="50"
    d:DesignWidth="500"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToHighlightBrushConverter x:Key="BoolToHighlight" />
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>

        <!-- Highlight rectangle behind all controls -->
        <Rectangle
            Grid.Column="0" Grid.ColumnSpan="2"
            Fill="{Binding UpToDate, Converter={StaticResource BoolToHighlight}}" />

        <TextBox
            Grid.Column="0"
            Margin="5"
            HorizontalAlignment="Stretch" VerticalAlignment="Center"
            IsEnabled="{Binding !IsActive}"
            MaxLength="{Binding MaxLengthTicker}"
            Text="{Binding Text}" />

        <CheckBox
            Grid.Column="1"
            Margin="5" VerticalAlignment="Center"
            Content="Active"
            IsChecked="{Binding IsActive}"
            IsEnabled="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Grid>
</UserControl>