<UserControl
    x:Class="Score2Stream.ScoreboardModule.Views.ContentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cl="clr-namespace:AvaloniaColorPicker;assembly=AvaloniaColorPicker"
    xmlns:conv="using:Score2Stream.Commons.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:v="using:Score2Stream.ScoreboardModule.Views"
    xmlns:vm="using:Score2Stream.ScoreboardModule.ViewModels"
    d:DesignWidth="600"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!--
            Grid.IsSharedSizeScope="True" activates SharedSizeGroup.
            Col 0 and Col 2 share the group "LabelCol": both are always
            exactly as wide as the widest label in either column.
            -->
            <Grid Margin="5" Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />  <!-- Col 0: Home label -->
                    <ColumnDefinition Width="*" />                                <!-- Col 1: Home input -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />  <!-- Col 2: Guest label -->
                    <ColumnDefinition Width="*" />                                <!-- Col 3: Guest input -->
                    <ColumnDefinition Width="120" />                              <!-- Col 4: Checkbox -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />  <!-- 0:  Color -->
                    <RowDefinition Height="*" />  <!-- 1:  Team name -->
                    <RowDefinition Height="*" />  <!-- 2:  Score -->
                    <RowDefinition Height="*" />  <!-- 3:  Fouls -->
                    <RowDefinition Height="10" /> <!-- 4:  Spacer -->
                    <RowDefinition Height="*" />  <!-- 5:  Game header -->
                    <RowDefinition Height="*" />  <!-- 6:  Game clock -->
                    <RowDefinition Height="*" />  <!-- 7:  Shot clock -->
                    <RowDefinition Height="*" />  <!-- 8:  Period / Periods -->
                    <RowDefinition Height="*" />  <!-- 9:  Game over -->
                    <RowDefinition Height="10" /> <!-- 10: Spacer -->
                    <RowDefinition Height="*" />  <!-- 11: Tickers header -->
                    <RowDefinition Height="*" />  <!-- 12: Ticker frequency -->
                </Grid.RowDefinitions>

                <!--
                Highlight rectangles: declared first so they render behind all controls.
                Each spans the columns of the field it covers and changes color via converter.
                -->
                <Rectangle Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Fill="{Binding ColorHomeUpToDate,  Converter={StaticResource BoolToHighlight}, ConverterParameter={StaticResource UpdateBackground}}" />
                <Rectangle Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1" Fill="{Binding ColorGuestUpToDate, Converter={StaticResource BoolToHighlight}, ConverterParameter={StaticResource UpdateBackground}}" />
                <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Fill="{Binding TeamHomeUpToDate,   Converter={StaticResource BoolToHighlight}, ConverterParameter={StaticResource UpdateBackground}}" />
                <Rectangle Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Fill="{Binding TeamGuestUpToDate,  Converter={StaticResource BoolToHighlight}, ConverterParameter={StaticResource UpdateBackground}}" />
                <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Fill="{Binding ScoreHomeUpToDate,  Converter={StaticResource BoolToHighlight}, ConverterParameter={StaticResource UpdateBackground}}" />
                <Rectangle Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Fill="{Binding ScoreGuestUpToDate, Converter={StaticResource BoolToHighlight}, ConverterParameter={StaticResource UpdateBackground}}" />
                <Rectangle Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Fill="{Binding FoulsHomeUpToDate,  Converter={StaticResource BoolToHighlight}, ConverterParameter={StaticResource UpdateBackground}}" />
                <Rectangle Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Fill="{Binding FoulsGuestUpToDate, Converter={StaticResource BoolToHighlight}, ConverterParameter={StaticResource UpdateBackground}}" />
                <Rectangle Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Fill="{Binding PeriodUpToDate,     Converter={StaticResource BoolToHighlight}, ConverterParameter={StaticResource UpdateBackground}}" />
                <Rectangle Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="2" Fill="{Binding PeriodsUpToDate,    Converter={StaticResource BoolToHighlight}, ConverterParameter={StaticResource UpdateBackground}}" />
                <Rectangle Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4" Fill="{Binding IsGameOverUpToDate, Converter={StaticResource BoolToHighlight}, ConverterParameter={StaticResource UpdateBackground}}" />

                <!-- ══════════════════════════════════════════════ Row 0: Colors ══ -->

                <TextBlock
                    Grid.Row="0" Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    FontWeight="Bold" Text="Home" />
                <cl:ColorButton
                    Grid.Row="0" Grid.Column="1"
                    Height="20" Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Color="{Binding ColorHome, Mode=TwoWay}" />

                <TextBlock
                    Grid.Row="0" Grid.Column="2"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    FontWeight="Bold" Text="Guest" />
                <cl:ColorButton
                    Grid.Row="0" Grid.Column="3"
                    Height="20" Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Color="{Binding ColorGuest, Mode=TwoWay}" />

                <!-- ══════════════════════════════════════════ Row 1: Team names ══ -->

                <TextBlock
                    Grid.Row="1" Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Text="Name" />
                <TextBox
                    Grid.Row="1" Grid.Column="1"
                    Margin="5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    MaxLength="{Binding MaxLengthTeam}"
                    Text="{Binding TeamHome}" />

                <TextBlock
                    Grid.Row="1" Grid.Column="2"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Text="Name" />
                <TextBox
                    Grid.Row="1" Grid.Column="3"
                    Margin="5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    MaxLength="{Binding MaxLengthTeam}"
                    Text="{Binding TeamGuest}" />

                <!-- ════════════════════════════════════════════════ Row 2: Score ══ -->

                <TextBlock
                    Grid.Row="2" Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Text="Score" />
                <TextBox
                    Grid.Row="2" Grid.Column="1"
                    Margin="5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    IsEnabled="{Binding #ScoreNotFromClip.IsChecked}"
                    MaxLength="{Binding MaxLengthScore}"
                    Text="{Binding ScoreHome}" />

                <TextBlock
                    Grid.Row="2" Grid.Column="2"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Text="Score" />
                <TextBox
                    Grid.Row="2" Grid.Column="3"
                    Margin="5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    IsEnabled="{Binding #ScoreNotFromClip.IsChecked}"
                    MaxLength="{Binding MaxLengthScore}"
                    Text="{Binding ScoreGuest}" />

                <CheckBox
                    x:Name="ScoreNotFromClip"
                    Grid.Row="2" Grid.Column="4"
                    Margin="5" VerticalAlignment="Center"
                    Content="Ignore clip"
                    IsChecked="{Binding ScoreNotFromClip}" />

                <!-- ════════════════════════════════════════════════ Row 3: Fouls ══ -->

                <TextBlock
                    Grid.Row="3" Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Text="Fouls" />
                <TextBox
                    Grid.Row="3" Grid.Column="1"
                    Margin="5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    IsEnabled="{Binding #FoulsNotFromClip.IsChecked}"
                    MaxLength="{Binding MaxLengthFouls}"
                    Text="{Binding FoulsHome}" />

                <TextBlock
                    Grid.Row="3" Grid.Column="2"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Text="Fouls" />
                <TextBox
                    Grid.Row="3" Grid.Column="3"
                    Margin="5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    IsEnabled="{Binding #FoulsNotFromClip.IsChecked}"
                    MaxLength="{Binding MaxLengthFouls}"
                    Text="{Binding FoulsGuest}" />

                <CheckBox
                    x:Name="FoulsNotFromClip"
                    Grid.Row="3" Grid.Column="4"
                    Margin="5" VerticalAlignment="Center"
                    Content="Ignore clip"
                    IsChecked="{Binding FoulsNotFromClip}" />

                <!-- ══════════════════════════════════════════ Row 5: Game header ══ -->

                <TextBlock
                    Grid.Row="5" Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    FontWeight="Bold" Text="Game" />

                <!-- ═══════════════════════════════════════════ Row 6: Game clock ══ -->

                <TextBlock
                    Grid.Row="6" Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    IsEnabled="False" Text="Game clock" />
                <TextBox
                    Grid.Row="6" Grid.Column="1"
                    Margin="5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    IsEnabled="False"
                    Text="{Binding ClockGame, Mode=OneWay}" />

                <CheckBox
                    x:Name="ShowTenthOfSecsCheckbox"
                    Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2"
                    Margin="5" VerticalAlignment="Center"
                    Content="Show tenth of seconds"
                    IsChecked="{Binding ShowTenthOfSecs}"
                    IsEnabled="{Binding !#ClockNotFromClip.IsChecked}" />

                <CheckBox
                    x:Name="ClockNotFromClip"
                    Grid.Row="6" Grid.Column="4"
                    Margin="5" VerticalAlignment="Center"
                    Content="Ignore clip"
                    IsChecked="{Binding ClockNotFromClip}" />

                <!-- ═══════════════════════════════════════════ Row 7: Shot clock ══ -->

                <TextBlock
                    Grid.Row="7" Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    IsEnabled="False" Text="Shot clock" />
                <TextBox
                    Grid.Row="7" Grid.Column="1"
                    Margin="5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    IsEnabled="False"
                    Text="{Binding ClockShot, Mode=OneWay}" />

                <CheckBox
                    x:Name="ShotNotFromClip"
                    Grid.Row="7" Grid.Column="4"
                    Margin="5" VerticalAlignment="Center"
                    Content="Ignore clip"
                    IsChecked="{Binding ShotNotFromClip}" />

                <!-- ══════════════════════════════════════ Row 8: Period / Periods ══ -->

                <TextBlock
                    Grid.Row="8" Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Text="Period" />
                <TextBox
                    Grid.Row="8" Grid.Column="1"
                    Margin="5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    IsEnabled="{Binding #PeriodNotFromClip.IsChecked}"
                    MaxLength="{Binding MaxLengthPeriod}"
                    Text="{Binding Period}" />

                <TextBlock
                    Grid.Row="8" Grid.Column="2"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Text="Periods" />
                <TextBox
                    Grid.Row="8" Grid.Column="3"
                    Margin="5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    MaxLength="{Binding MaxLengthPeriod}"
                    Text="{Binding Periods}" />

                <CheckBox
                    x:Name="PeriodNotFromClip"
                    Grid.Row="8" Grid.Column="4"
                    Margin="5" VerticalAlignment="Center"
                    Content="Ignore clip"
                    IsChecked="{Binding PeriodNotFromClip}" />

                <!-- ══════════════════════════════════════════════ Row 9: Game over ══ -->

                <CheckBox
                    Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4"
                    Margin="5" VerticalAlignment="Center"
                    Content="Game is over"
                    IsChecked="{Binding IsGameOver}" />

                <!-- ══════════════════════════════════════ Row 11: Tickers header ══ -->

                <TextBlock
                    Grid.Row="11" Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    FontWeight="Bold" Text="Tickers" />

                <!-- ═══════════════════════════════════════ Row 12: Ticker frequency ══ -->

                <TextBlock
                    Grid.Row="12" Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Text="Frequency [s]" />
                <NumericUpDown
                    Grid.Row="12" Grid.Column="1"
                    Width="120" Margin="5"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Increment="5" Maximum="60" Minimum="5"
                    Value="{Binding TickersFrequency, Mode=TwoWay}" />
            </Grid>

            <ItemsControl Margin="5" ItemsSource="{Binding Tickers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:TickerViewModel">
                        <v:TickerView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>